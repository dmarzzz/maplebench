<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.maplebench</groupId>
  <artifactId>persistence-receipt-tests</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-api</artifactId><version>5.13.1</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-engine</artifactId><version>5.13.1</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>../../patches/cosmic/overlay/src/main/java</sourceDirectory>
    <testSourceDirectory>../../patches/cosmic/overlay/src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>2.6</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.1</version>
        <configuration>
          <includes><include>**/MapleBenchPersistence.java</include><include>**/MapleBenchXpLedger.java</include></includes>
          <compilerArguments>
            <sourcepath>${project.basedir}/../../patches/cosmic/overlay/src/main/java${path.separator}${project.basedir}/native-source</sourcepath>
          </compilerArguments>
          <testIncludes><testInclude>**/MapleBenchPersistenceTest.java</testInclude><testInclude>**/MapleBenchXpLedgerTest.java</testInclude></testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version>
        <configuration>
          <forkCount>1</forkCount><reuseForks>true</reuseForks>
          <argLine>-Xmx512m -XX:ActiveProcessorCount=2</argLine>
          <forkedProcessTimeoutInSeconds>90</forkedProcessTimeoutInSeconds>
          <includes><include>**/MapleBenchPersistenceTest.java</include><include>**/MapleBenchXpLedgerTest.java</include></includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
