+    // Skill.wz/312.img/3120005: mastery uses 5% steps; x is weapon attack.
+    // String.wz level 30 confirms 90% mastery and +10 WATK, bow only.
+    class BowExpertBuff final : public PassiveBuff
+    {
+    public:
+        bool is_applicable(CharStats& stats, nl::node) const override
+        {
+            return stats.get_weapontype() == Weapon::BOW;
+        }
+
+        void apply_to(CharStats& stats, nl::node level) const override
+        {
+            float mastery = 0.1f + static_cast<float>(level["mastery"]) * 0.05f;
+            stats.set_mastery(mastery > stats.get_mastery() ? mastery : stats.get_mastery());
+            stats.add_value(Equipstat::WATK, level["x"]);
+        }
+    };
+
