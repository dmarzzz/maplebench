+    // Hurricane reconstruction v1: fixed 120ms packet cadence (LazyBui's
+    // 2008 packet-tick experiment), independent of weapon animation speed.
+    // Startup uses pinned Skill/312.img/skill/3121004/prepare/time = 960ms.
+    // The preparation FX frame durations are NOT the projectile clock.
+    bool Combat::channel_permitted()
+    {
+        return !player.is_dead() && !player.is_climbing() && !player.is_sitting()
+            && !player.is_key_down(KeyAction::LEFT) && !player.is_key_down(KeyAction::RIGHT)
+            && !player.is_key_down(KeyAction::UP) && !player.is_key_down(KeyAction::DOWN)
+            && !player.is_key_down(KeyAction::JUMP) && !player.is_key_down(KeyAction::ATTACK)
+            && player.get_stats().get_weapontype() == Weapon::BOW
+            && player.can_use(get_move(3121004)) == SpecialMove::FBR_NONE;
+    }
+
+    void Combat::cancel_channel()
+    {
+        hurricane_active = false;
+        hurricane_until_shot_ms = 0;
+        // Keep the physical-key latch until keyup. Repeated keydown events
+        // must not restart a cancelled channel or cross a map transition.
+    }
+
+    void Combat::send_skill_key(int32_t move_id, bool down)
+    {
+        if (move_id != 3121004)
+        {
+            if (down)
+            {
+                cancel_channel();
+                use_move(move_id);
+            }
+            return;
+        }
+        if (!down)
+        {
+            hurricane_key_down = false;
+            cancel_channel();
+            return;
+        }
+        if (hurricane_key_down)
+            return;
+        hurricane_key_down = true;
+        if (!player.can_attack() || !channel_permitted())
+            return;
+        hurricane_active = true;
+        hurricane_until_shot_ms = 960;
+        player.attack(std::string("shoot1"));
+    }
+
+    void Combat::update_channel()
+    {
+        if (!hurricane_active)
+            return;
+        if (!channel_permitted())
+        {
+            cancel_channel();
+            return;
+        }
+        hurricane_until_shot_ms -= Constants::TIMESTEP;
+        if (hurricane_until_shot_ms > 0)
+            return;
+        hurricane_until_shot_ms += 120;
+        // The channel owns this animation; can_attack() would reject its own
+        // previous pose. Admission/resources are still checked every update.
+        // Every pulse uses the ordinary ranged packet and server cost path.
+        apply_move(get_move(3121004));
+    }
