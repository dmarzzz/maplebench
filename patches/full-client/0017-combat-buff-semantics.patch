@@ -0,0 +1,47 @@
+// MapleBench native combat buff policy, AGPL-3.0-or-later.
+// Formula provenance and qualification limits: FULL_CLIENT_COMBAT_BUFFS.md.
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace jrc
+{
+    inline bool is_combo_finisher(int32_t skill)
+    {
+        return skill == 1111003 || skill == 1111004
+            || skill == 1111005 || skill == 1111006;
+    }
+
+    struct ComboDamage
+    {
+        int32_t orbs = 0;
+        int32_t percent = 100;
+    };
+
+    // Count is the server's COMBO value: 1 means active with zero orbs.
+    // Damage and capacity are from the current learned skill's NX level.
+    inline ComboDamage combo_damage(int32_t count, int32_t combo_level,
+        int32_t first_orb_percent, int32_t capacity)
+    {
+        if (count <= 1 || combo_level <= 0 || first_orb_percent <= 0 || capacity <= 0)
+            return {};
+
+        const int32_t orbs = std::min(count - 1, capacity);
+        const int32_t extra = orbs <= 5
+            ? (orbs - 1) * combo_level / 6
+            : 20 + (orbs - 5) * 4;
+        return {orbs, first_orb_percent + extra};
+    }
+
+    inline int32_t combo_finisher_percent(int32_t orbs)
+    {
+        switch (orbs)
+        {
+        case 0: case 1: return 100;
+        case 2: return 120;
+        case 3: return 154;
+        case 4: return 200;
+        default: return 250;
+        }
+    }
+}
