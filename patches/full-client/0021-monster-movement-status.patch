+++ b/src/client/Net/Handlers/Helpers/MobStatusPacket.h
@@ -0,0 +1,88 @@
+#pragma once
+#include "MobTemporaryStatMasks.h"
+#include "../../InPacket.h"
+#include "../../../Gameplay/MapleMap/MobMovementStatus.h"
+
+namespace jrc
+{
+    struct MobStatusPacket
+    {
+        MobMovementStatus movement;
+        bool reflect_weapon = false, reflect_magic = false;
+        size_t count = 0;
+    };
+
+    inline MobStatusPacket read_mob_status(InPacket& recv, bool dynamic, bool cancel = false)
+    {
+        if (recv.length() < 16) throw PacketError("Truncated monster status mask");
+        const std::array<int32_t, 4> masks{{recv.read_int(), recv.read_int(),
+            recv.read_int(), recv.read_int()}};
+        const size_t first = dynamic ? 2 : 0, second = dynamic ? 3 : 2;
+        // Cosmic's spawn writer repeats each int in its following slot.
+        if (dynamic ? (masks[0] != 0 || masks[1] != 0)
+                    : (masks[0] != masks[1] || masks[2] != masks[3]))
+            throw PacketError("Invalid monster status mask layout");
+        uint32_t known_first = 0, known_second = 0;
+        for (const auto& status : MobTemporaryStatMasks::ALL)
+            (status.first_mask ? known_first : known_second) |= static_cast<uint32_t>(status.value);
+        if ((static_cast<uint32_t>(masks[first]) & ~known_first)
+            || (static_cast<uint32_t>(masks[second]) & ~known_second))
+            throw PacketError("Unknown monster status mask");
+        size_t payload_count = 0, reflects = 0;
+        for (const auto& status : MobTemporaryStatMasks::ALL)
+        {
+            if (!(masks[status.first_mask ? first : second] & status.value)) continue;
+            ++payload_count;
+            if (status.first_mask && (status.value == MobTemporaryStatMasks::WEAPON_REFLECT
+                || status.value == MobTemporaryStatMasks::MAGIC_REFLECT)) ++reflects;
+        }
+        const size_t required = (cancel ? 0 : payload_count * 8)
+            + (dynamic ? (cancel ? 4 : 5 + (reflects ? 4 : 0))
+                       : (reflects ? 4 * (reflects + 1) : 0));
+        if (recv.length() < required || (dynamic && recv.length() != required))
+            throw PacketError("Truncated or trailing monster status payload");
+        MobStatusPacket result;
+        for (const auto& status : MobTemporaryStatMasks::ALL)
+        {
+            if (!(masks[status.first_mask ? first : second] & status.value))
+                continue;
+            ++result.count;
+            int16_t value = 0;
+            if (!cancel)
+            {
+                value = recv.read_short();
+                recv.read_int(); // skill or mob-skill identity
+                recv.read_short(); // server owns cancellation; never invent TTL
+            }
+            if (!status.first_mask && (status.value == MobMovementStatus::SPEED
+                || status.value == MobMovementStatus::STUN || status.value == MobMovementStatus::FREEZE))
+            {
+                result.movement.fields |= status.value;
+                if (status.value == MobMovementStatus::SPEED) result.movement.speed = value;
+            }
+            result.reflect_weapon |= status.first_mask && status.value == MobTemporaryStatMasks::WEAPON_REFLECT;
+            result.reflect_magic |= status.first_mask && status.value == MobTemporaryStatMasks::MAGIC_REFLECT;
+        }
+        if (!dynamic)
+        {
+            if (result.reflect_weapon) recv.read_int();
+            if (result.reflect_magic) recv.read_int();
+            if (result.reflect_weapon || result.reflect_magic) recv.read_int();
+        }
+        else
+        {
+            if (!cancel)
+            {
+                // Pinned MobSkill's three reflection cases each append one int.
+                const bool reflected = result.reflect_weapon || result.reflect_magic;
+                if (reflected) recv.read_int();
+                const auto expected = reflected ? result.count / 2 : result.count;
+                if (static_cast<uint8_t>(recv.read_byte()) != expected)
+                    throw PacketError("Invalid monster status count");
+            }
+            recv.read_int(); // trailing delay, not an expiry
+            if (recv.length() != 0) throw PacketError("Trailing monster status bytes");
+        }
+        return result;
+    }
+}
