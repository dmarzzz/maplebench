@@ -0,0 +1,31 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace jrc
+{
+    // Only server-received movement effects. Wire duration -1 is not a TTL.
+    struct MobMovementStatus
+    {
+        static constexpr uint32_t SPEED = 0x40, STUN = 0x80, FREEZE = 0x100;
+        uint32_t fields = 0;
+        int16_t speed = 0;
+        bool stopped() const { return (fields & (STUN | FREEZE)) != 0; }
+        void merge(const MobMovementStatus& update, bool cancel)
+        {
+            if (cancel)
+                fields &= ~update.fields;
+            else
+                fields |= update.fields;
+            if (update.fields & SPEED)
+                speed = cancel ? 0 : update.speed;
+        }
+        double force(double base, double unit) const
+        {
+            // Declared port scale, matching MapleBenchMobMotion's additive
+            // WZ+SPEED percentage and [0,200] clamp; no animation time scaling.
+            if (!(fields & SPEED)) return base;
+            return std::max(0.0, std::min(200.0, base / unit + speed)) * unit;
+        }
+    };
+}
