+// MapleBench Shadow Partner packet-line scaling. AGPL-3.0-or-later.
+#pragma once
+#include "Attack.h"
+#include <algorithm>
+
+namespace jrc
+{
+    inline void scale_shadow_partner(AttackResult& result, int32_t percent)
+    {
+        if (result.type != Attack::RANGED || percent < 1 || percent > 100
+            || result.hitcount < 2 || result.hitcount > 14 || result.hitcount % 2)
+            return;
+        for (auto& target : result.damagelines)
+        {
+            auto& lines = target.second;
+            if (lines.size() != result.hitcount)
+                continue;
+            for (size_t i = result.hitcount / 2; i < lines.size(); ++i)
+            {
+                // Preserve independently rolled misses/crit flags. Scale the
+                // native defended final damage, without a second critical roll.
+                if (lines[i].first > 0)
+                    lines[i].first = static_cast<int32_t>(std::max<int64_t>(1,
+                        static_cast<int64_t>(lines[i].first) * percent / 100));
+            }
+        }
+    }
+}
