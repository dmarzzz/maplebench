+        const Buff& partner = buffs[Buffstat::SHADOWPARTNER];
+        const int32_t level = get_skilllevel(4111002);
+        if (partner.stat != Buffstat::SHADOWPARTNER || partner.skillid != 4111002
+            || partner.value <= 0 || level < 1 || level > 30)
+            return 0;
+        const nl::node data = nl::nx::skill["411.img"]["skill"]["4111002"]
+            ["level"][std::to_string(level)];
+        // A learned-level change must not upgrade a previously received buff.
+        if (static_cast<int32_t>(data["x"]) != partner.value)
+            return 0;
+        const int32_t percent = data[skill ? "y" : "x"];
+        return percent > 0 && percent <= 100 ? percent : 0;
+    }
