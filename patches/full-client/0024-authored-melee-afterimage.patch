--- /dev/null
+++ b/src/client/Character/Look/AfterimageRange.h
@@ -0,0 +1,64 @@
+// MapleBench authored afterimage lookup, AGPL-3.0-or-later.
+#pragma once
+#include <string>
+
+namespace jrc
+{
+    template<class Rectangle>
+    bool valid_melee_range(const Rectangle& range)
+    {
+        return range.l() < range.r() && range.t() < range.b();
+    }
+
+    // Keep an exact authored bucket. Higher-level weapons can outgrow the
+    // asset's bucket set; use the nearest lower valid bucket for this same
+    // family and stance, independent of child ordering. Never invent reach.
+    template<class Node, class Valid>
+    Node weapon_afterimage(Node family, int requested, const std::string& stance,
+                          Valid valid)
+    {
+        if (requested < 0 || family.size() > 64)
+            return {};
+        Node exact = family[requested][stance];
+        if (valid(exact))
+            return exact;
+        Node selected;
+        int selected_bucket = -1;
+        for (Node bucket : family)
+        {
+            const std::string name = bucket.name();
+            if (name.empty() || name.size() > 3)
+                continue;
+            int number = 0;
+            bool numeric = true;
+            for (char c : name)
+            {
+                if (c < '0' || c > '9') { numeric = false; break; }
+                number = number * 10 + c - '0';
+            }
+            if (!numeric || std::to_string(number) != name || number > requested
+                || number <= selected_bucket)
+                continue;
+            Node candidate = bucket[stance];
+            if (valid(candidate))
+            {
+                selected = candidate;
+                selected_bucket = number;
+            }
+        }
+        return selected;
+    }
+
+    template<class Rectangle>
+    bool authored_melee_range(Rectangle& target, const Rectangle& afterimage,
+                              const Rectangle& skill)
+    {
+        if (valid_melee_range(afterimage))
+            target = afterimage;
+        else if (valid_melee_range(skill))
+            target = skill;
+        else
+            return false;
+        return true;
+    }
+}
